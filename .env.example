# Firebase Web App config (public Firebase configuration; Vite embeds VITE_* values in the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Vercel server-only Firebase Admin credentials. Never prefix these with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# The first Firebase Auth account matching this address is provisioned as the first admin once.
INITIAL_ADMIN_EMAIL=
